{
  "name": "finance-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "api",
    "web",
    "infra"
  ],
  "scripts": {
    "typecheck": "tsc -p shared --noEmit && tsc -p api --noEmit && tsc -p infra --noEmit && tsc -p web --noEmit",
    "test": "vitest run",
    "build:web": "npm run build -w web",
    "synth": "npm run synth -w @finance/infra",
    "deploy": "npm run deploy -w @finance/infra"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1166.0",
    "@types/node": "^24.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
