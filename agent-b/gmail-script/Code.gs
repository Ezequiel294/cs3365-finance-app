/** Paste into script.google.com. Set API_URL and INGEST_TOKEN in Script Properties. */
const PROCESSED_LABEL='finance-app-processed';
function setup(){const url=PropertiesService.getScriptProperties().getProperty('API_URL');const token=PropertiesService.getScriptProperties().getProperty('INGEST_TOKEN');if(!url||!token)throw new Error('Set API_URL and INGEST_TOKEN in Script Properties');const response=UrlFetchApp.fetch(url+'/ingest/gmail/config',{headers:{Authorization:'Bearer '+token},muteHttpExceptions:true});if(response.getResponseCode()!==200)throw new Error('Finance App setup failed: '+response.getResponseCode());ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='run').forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('run').timeBased().everyMinutes(5).create();}
function run(){const props=PropertiesService.getScriptProperties();const url=props.getProperty('API_URL'),token=props.getProperty('INGEST_TOKEN');if(!url||!token)return;const config=JSON.parse(UrlFetchApp.fetch(url+'/ingest/gmail/config',{headers:{Authorization:'Bearer '+token},muteHttpExceptions:true}).getContentText());const label=GmailApp.getUserLabelByName(PROCESSED_LABEL)||GmailApp.createLabel(PROCESSED_LABEL);const senders=(config.senders||[]).map(s=>'from:'+s).join(' OR ');GmailApp.search('('+senders+') -label:'+PROCESSED_LABEL,0,50).forEach(thread=>thread.getMessages().forEach(message=>{if(message.getLabels().some(l=>l.getName()===PROCESSED_LABEL))return;const r=UrlFetchApp.fetch(url+'/ingest/gmail',{method:'post',contentType:'text/plain',payload:message.getRawContent(),headers:{Authorization:'Bearer '+token},muteHttpExceptions:true});if(r.getResponseCode()>=200&&r.getResponseCode()<300)message.addLabel(label);if(r.getResponseCode()===401){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='run').forEach(t=>ScriptApp.deleteTrigger(t));}}));UrlFetchApp.fetch(url+'/ingest/gmail/heartbeat',{method:'post',headers:{Authorization:'Bearer '+token},muteHttpExceptions:true});}
