/** Set API_BASE and INGEST_TOKEN in Script Properties before setup(). */
const PROPS = PropertiesService.getScriptProperties();
function setup() { fetchConfig(); ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === 'run').forEach(t => ScriptApp.deleteTrigger(t)); ScriptApp.newTrigger('run').timeBased().everyMinutes(5).create(); }
function fetchConfig() { const r = request('/ingest/gmail/config', null); if (r.getResponseCode() === 401) throw new Error('Ingest token is invalid or revoked'); if (r.getResponseCode() < 200 || r.getResponseCode() >= 300) throw new Error('Configuration request failed'); return JSON.parse(r.getContentText()); }
function run() { const config=fetchConfig(), label=GmailApp.getUserLabelByName(config.label)||GmailApp.createLabel(config.label); const query='from:('+config.senders.join(' OR ')+') -label:'+config.label; GmailApp.search(query).forEach(thread=>thread.getMessages().forEach(message=>{if(!message.getLabels().some(x=>x.getName()===config.label)){const response=request('/ingest/gmail',message.getRawContent());if(response.getResponseCode()===401){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='run').forEach(t=>ScriptApp.deleteTrigger(t));throw new Error('Token revoked; trigger removed.');}if(response.getResponseCode()>=200&&response.getResponseCode()<300)message.addLabel(label);}})); request('/ingest/gmail/heartbeat','{}'); }
function request(path,payload) { const base=PROPS.getProperty('API_BASE'), token=PROPS.getProperty('INGEST_TOKEN'); if(!base||!token)throw new Error('Set API_BASE and INGEST_TOKEN Script Properties'); return UrlFetchApp.fetch(base+path,{method:payload===null?'get':'post',contentType:'message/rfc822',payload:payload||undefined,headers:{Authorization:'Bearer '+token},muteHttpExceptions:true}); }
