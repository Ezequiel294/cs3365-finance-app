/* Paste into Google Apps Script. Set API_BASE and INGEST_TOKEN in Script Properties. */
const LABEL='financeapp-processed';
function property_(name){const value=PropertiesService.getScriptProperties().getProperty(name);if(!value)throw new Error(`Set ${name} in Script Properties`);return value;}
function request_(path,options){const token=property_('INGEST_TOKEN');return UrlFetchApp.fetch(property_('API_BASE')+path,{muteHttpExceptions:true,...options,headers:{...(options.headers||{}),Authorization:`Bearer ${token}`}});}
function setup(){const response=request_('/ingest/gmail/config',{method:'get'});if(response.getResponseCode()!==200)throw new Error('Setup failed. Check the API URL and connection key.');ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='run').forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('run').timeBased().everyMinutes(5).create();}
function run(){const config=JSON.parse(request_('/ingest/gmail/config',{method:'get'}).getContentText());const query=`from:(${config.senders.join(' OR ')}) -label:${LABEL}`;const label=GmailApp.getUserLabelByName(LABEL)||GmailApp.createLabel(LABEL);for(const thread of GmailApp.search(query)){for(const message of thread.getMessages()){const response=request_('/ingest/gmail',{method:'post',contentType:'message/rfc822',payload:message.getRawContent()});if(response.getResponseCode()>=200&&response.getResponseCode()<300)message.addLabel(label);else if(response.getResponseCode()===401){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='run').forEach(t=>ScriptApp.deleteTrigger(t));return;}}}request_('/ingest/gmail/heartbeat',{method:'post'});}
