<mxfile host="app.diagrams.net"><diagram id="architecture" name="Architecture"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;CS3365 Finance App: architecture&lt;/b&gt; (personal AWS account, us-east-2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="200" y="0" width="700" height="30" as="geometry"/></mxCell><mxCell id="browser" value="User browser&lt;br&gt;(Next.js UI / PWA)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#232F3E;fillColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="70" y="439" width="60" height="60" as="geometry"/></mxCell><mxCell id="gmail" value="Gmail inbox&lt;br&gt;+ Apps Script&lt;br&gt;(every 5 min)" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;shape=mxgraph.weblogos.gmail" vertex="1" parent="1"><mxGeometry x="55" y="190" width="65" height="47" as="geometry"/></mxCell><mxCell id="bccr" value="&lt;b&gt;BCCR&lt;/b&gt; exchange-rate API&lt;br&gt;(external)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="940" y="1000" width="180" height="56" as="geometry"/></mxCell><mxCell id="cloud" value="AWS Cloud (Free plan project)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontC